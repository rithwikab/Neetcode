/*
time complexity - O(log(m*n))
space complexity - O(1)
INTUITION
The matrix is sorted row-wise like a sorted 1D array.

So imagine flattening it mentally into a single sorted list of length m × n.

Use binary search on this virtual array (indices 0 → m*n−1).

Convert virtual index → real matrix cell using:

row = mid / n

col = mid % n

Compare target with that cell and move left or right like normal binary search.
*/






class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int m = matrix.length;
        int n = matrix[0].length;
        int l = 0;
        int r = m*n-1;
        while(l<=r){
            int mid = (l+r)/2;
            int rId = mid/n;
            int cId = (mid % n);
            System.out.println(rId+" "+cId);
            if(matrix[rId][cId]==target)return true;
            else if(target > matrix[rId][cId]){
                l = mid+1;
            }
            else{
                r =mid-1;
            }
        }
        return false;
    }
}
