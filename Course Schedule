/*
Time Complexity: O(V + E)

Each course (V) is DFS’d once

Each prerequisite edge (E) is visited once

Clearing adjacency list ensures no rework

Space Complexity: O(V + E)

Graph storage

visited set (DFS path)

Recursive stack up to O(V)

Intuition (Simple)

Courses form a directed graph

You can finish all courses iff there is NO cycle

Use DFS to detect a cycle

If a course appears again in the current DFS path, cycle exists

🔁 Step-by-Step DFS Logic

For a course:

If it’s already in visited → cycle → false

If it has no prerequisites → safe → true

Mark it as visited (current path)

DFS all prerequisites

Remove from path

Clear its prereq list (memoization)

Return true
*/
class Solution {
    Map<Integer,List<Integer>> m = new HashMap<>();
    Set<Integer> visited = new HashSet<>();
    public boolean canFinish(int numCourses, int[][] prerequisites) {
        for(int i=0;i<numCourses;i++){
            m.put(i,new ArrayList<>());
        }
        for(int i=0;i<prerequisites.length;i++){
            m.get(prerequisites[i][0]).add(prerequisites[i][1]);
        }
        for(int i=0;i<numCourses;i++){
            if(!dfs(i)){
                return false;
            }
        }
        return true;
    }
    public boolean dfs(int course){
        if(visited.contains(course)){
            return false;
        }
        if(m.get(course).size()==0){
            return true;
        }
        visited.add(course);
        for(int i:m.get(course)){
            if(!dfs(i)){
                return false;
            }
        }
        visited.remove(course);
        m.put(course,new ArrayList<>());
        return true;
    }
}
