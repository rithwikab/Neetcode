/**/
time complexity - O(n)
space complexity - O(1)
INTUITION
1️⃣ Do a postorder DFS (children → parent)

2️⃣ Each recursive call returns:

the height of the subtree if balanced

-1 if the subtree is not balanced

3️⃣ At each node:

get left height

get right height

if either is -1 → propagate -1

if |left − right| > 1 → return -1

else → return 1 + max(left, right)

4️⃣ Final check:

if DFS returns -1 → not balanced

else → balanced
/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class Solution {
    public boolean isBalanced(TreeNode root) {
        return dfs(root) != -1;
    }

    public int dfs(TreeNode root) {
        if (root == null) return 0;

        int left = dfs(root.left);
        if (left == -1) return -1;

        int right = dfs(root.right);
        if (right == -1) return -1;

        if (Math.abs(left - right) > 1) return -1;

        return 1 + Math.max(left, right);
    }
}
