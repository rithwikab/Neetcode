/*
time complexity - O(n!*n)
space complexity - O(n!*n)
explanation - for each array of n unique elements , the number of permutations is n!
at each of the n! permutations , while writing cur to res , we use copy function which takes O(n) time - so total time is n!*n
similarly output res contains n! permutations , each permutations has n elements so n!*n space
auxiliary space is O(n) - 
cur list → O(n)

visited array → O(n)

Recursion stack depth → O(n)
INTUITION
We try every number at every position, mark it as used, go deeper to fill the next position,
and once a full permutation is formed we save it—then we backtrack by un-using the number so other orders can be explored.
*/

class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> cur = new ArrayList<>();
        int[] visited = new int[nums.length];
        dfs(nums,cur,res,visited);
        return res;
    }
    public void dfs(int[] nums,List<Integer> cur , List<List<Integer>> res,int[] visited){
        
        if(cur.size()==nums.length){
            res.add(new ArrayList(cur));
            return;
        }
        for(int i=0;i<nums.length;i++){
            if(visited[i]==1)continue;
            cur.add(nums[i]);
            visited[i]=1;
            dfs(nums,cur,res,visited);
            visited[i]=0;
            cur.remove(cur.size()-1);

        }
       

    }
}
