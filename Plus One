/*
Time & space

Time: O(n)

Space: O(n) (because of the list)

Simple intuition

Adding 1 is just normal digit addition

Start from the last digit with carry = 1

Push (digit + carry) % 10

Update carry = (digit + carry) / 10

If carry remains at the end, add it

*/
class Solution {
    public int[] plusOne(int[] digits) {
        for (int i = digits.length - 1; i >= 0; i--) {
            if (digits[i] < 9) {
                digits[i]++;
                return digits;
            }
            digits[i] = 0;
        }

        int[] res = new int[digits.length + 1];
        res[0] = 1;
        return res;
    }
}
