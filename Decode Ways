/*
Time Complexity

One pass over the string

Time: O(n)
Space Complexity

DP array of size n + 1

Space: O(n)

Simple intuition

At every index, you have choices:

Decode one digit (if it’s not '0')

Decode two digits (if they form a number between 10 and 26)

The total number of decodings from position i is the sum of valid choices from that position.
*/

class Solution {
    public int numDecodings(String s) {
        int[] dp = new int[s.length()+1];
        // dp[i] represents the number of ways to decode string i..end
        //empty string can be decoded only 1 way
        //if i'm considering it as one digit , then the remaining string is also one whole part and it will depend on number of ways that part is decoded
        dp[s.length()] = 1;
        for(int i=s.length()-1;i>=0;i--){
            if(s.charAt(i)=='0'){
                dp[i]=0;
            }
            else{
                // if single digit from i to end , can only be decoded one way
                dp[i] = dp[i+1];
                // if more than 1 digit between i and end , can be decoded two ways
                // ith value can be decoded as a single digit
                // or i and i+1 grouped and added to number of ways to decode i+2
                // not adding number of ways to single digit decode here as its already stored 
                //in dp array from first line of else
                if(i+1<s.length() && (s.charAt(i)=='1' ||
                s.charAt(i)=='2' && s.charAt(i+1)<'7')){
                    dp[i]+=dp[i+2];
                }
            }
        }
        return dp[0];
    }
}
