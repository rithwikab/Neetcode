/* To reduce the space complexity to O(n) we can use bit manipulation */
/* use 3 arrays of size 9 indexed 0 to 8 , for row , col , sqr 
the number of 1s in bitwise representation of each entry of row,col,sqr array indicate which digit already occured in that specific row,col,sqr
*/
/* time complexity o(n^2) space complexity o(3*n)=o(n)*/
public class Solution {
    public boolean isValidSudoku(char[][] board) {
        int[] rows=new int[9];
        int[] cols=new int[9];
        int[] sqr=new int[9];
        for(int r=0;r<9;r++){
            for(int c=0;c<9;c++){
                if(board[r][c] == '.')continue;
                int val = board[r][c]-'1';
                if((rows[r] & (1<<val))>0 || 
                (cols[c] & (1<<val))>0 || 
                (sqr[(r/3)*3 + (c/3)] & (1<<val)) > 0 ){
                    return false;
                }
                rows[r] |= (1<<val);
                cols[c] |= (1<<val);
                sqr[(r/3)*3+(c/3)] |= (1<<val);
            }
        }
        return true;
    }
}
