/* time complexity - O(n)
space complexity = O(1)
INTUITION 
Walk through both linked lists at the same time.

At each step, take the current digits (use 0 if one list ended).

Add them + the carry from the previous step.

Put the last digit of the sum in the new list.

Carry the leftover to the next step.

Continue until both lists are done and no carry remains.
*/


class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy = new ListNode(0);
        ListNode cur = dummy;
        int carry = 0;

        while (l1 != null || l2 != null) {
            int x = (l1 != null) ? l1.val : 0;
            int y = (l2 != null) ? l2.val : 0;

            int sum = x + y + carry;
            carry = sum / 10;

            cur.next = new ListNode(sum % 10);
            cur = cur.next;

            if (l1 != null) l1 = l1.next;
            if (l2 != null) l2 = l2.next;
        }

        if (carry != 0) {
            cur.next = new ListNode(carry);
        }

        return dummy.next;
    }
}
