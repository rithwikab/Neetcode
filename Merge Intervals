/*
🔹 Time Complexity

O(n log n)
Sorting dominates.

🔹 Space Complexity

O(n)
Output list.

🔹 Intuition (step-by-step)

Sort intervals by start time.

Traverse intervals from left to right.

If the current interval overlaps with the next one:

Merge them by expanding the next interval’s boundaries.

If there is no overlap:

The current interval is finalized → add it to the result.

Continue until all intervals are processed.
*/
class Solution {
    public int[][] merge(int[][] intervals) {
        Arrays.sort(intervals,(a,b)->a[0]-b[0]);
        List<int[]> res = new ArrayList<>();
        for(int i=0;i<intervals.length;i++){
            if(i+1<intervals.length){
                if(intervals[i][1] >= intervals[i+1][0]){
                    intervals[i+1][0] = Math.min(intervals[i][0],intervals[i+1][0]);
                    intervals[i+1][1] = Math.max(intervals[i][1],intervals[i+1][1]);
                    continue;
                }
            }
            res.add(intervals[i]);
        }
        return res.toArray(new int[res.size()][2]);
    }
}
