/* Using bucket sort , the bucket contains the frequencies ranging from 0 to length of the given array , for each of those frequencies a bucket of elements with those frequencies are stored , we reetrieve the top k such elements by traversing the frequencies array
time is O(n) to make map,bucket array and to traverse through the buckets(max k), space complexity is o(n)*/
public class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        Map<Integer, Integer> count = new HashMap<>();
        for (int num : nums) {
            count.put(num, count.getOrDefault(num, 0) + 1);
        }
        List<Integer>[] bucket = new List[nums.length+1];
        for(int i=0;i<nums.length+1;i++){
            bucket[i]=new ArrayList<Integer>();
        }
        for(Map.Entry<Integer,Integer> e:count.entrySet())
        {
            bucket[e.getValue()].add(e.getKey());
        }
       
        int[] res = new int[k];
        int id = 0;
        for (int i = nums.length; i >= 0 && id<k; i--) {
            for(int n:bucket[i]){
                res[id++]=n;
                if(id==k) return res;
            }
        }
        return res;
    }
}
