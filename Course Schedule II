/*
⏱️ Final Complexity

Time: O(V + E) ✅

Space: O(V + E) ✅

🧠 Intuition

Directed graph

Need topological ordering

If a cycle exists → impossible

DFS:

Detect cycle using recursion path

Add course after prerequisites (postorder)

🔁 Step-by-Step DFS Logic

For each course:

If currently in recursion path → cycle

If already completed → skip

Mark as visiting

DFS all prerequisites

Mark as completed

Add to result list
*/

class Solution {
    Map<Integer, List<Integer>> m = new HashMap<>();
    int[] state; // 0 = unvisited, 1 = visiting, 2 = visited
    List<Integer> order = new ArrayList<>();

    public int[] findOrder(int numCourses, int[][] prerequisites) {
        state = new int[numCourses];

        for (int i = 0; i < numCourses; i++) {
            m.put(i, new ArrayList<>());
        }
        for (int[] p : prerequisites) {
            m.get(p[0]).add(p[1]);
        }

        for (int i = 0; i < numCourses; i++) {
            if (!dfs(i)) return new int[0];
        }

        int[] res = new int[numCourses];
        for (int i = 0; i < numCourses; i++) {
            res[i] = order.get(i);
        }
        return res;
    }

    private boolean dfs(int course) {
        if (state[course] == 1) return false; // cycle
        if (state[course] == 2) return true;  // already done

        state[course] = 1;
        for (int pre : m.get(course)) {
            if (!dfs(pre)) return false;
        }
        state[course] = 2;
        order.add(course);
        return true;
    }
}
