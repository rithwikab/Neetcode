/*
Time complexity

O(n × m)
Two full passes over the matrix.

Space complexity

O(1)
Only one boolean variable used; everything else is in-place.

Simple intuition

We’re not allowed extra space, so we reuse the matrix itself.

If matrix[i][j] == 0, then:

mark its column using matrix[0][j]

mark its row using matrix[i][0]

First row is special → track it separately with a boolean.

Second pass: if a row or column is marked, zero the cell.

Finally, zero the first row/column if needed.
*/
class Solution {
    public void setZeroes(int[][] matrix) {
        int n = matrix.length;
        int m = matrix[0].length;
        boolean rowZero = false;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(matrix[i][j]==0){
                    matrix[0][j] = 0;
                    if(i==0){
                        rowZero = true;
                    }
                    else{
                        matrix[i][0] = 0;
                    }
                    
                }
            }
        }
        for(int i=1;i<n;i++){
            for(int j=1;j<m;j++){
                if(matrix[0][j]==0 || matrix[i][0] == 0){
                    matrix[i][j] = 0;
                }
            }
        }
        if(matrix[0][0]==0){
            for(int r=0;r<n;r++){
                matrix[r][0] = 0;
            }
        }
        if(rowZero){
            for(int c = 0;c<m;c++){
                matrix[0][c] = 0;
            }
        }
    }
}
