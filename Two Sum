class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] ans=new int[2];
        List<Integer> l=new ArrayList();
        for(int i:nums){
            l.add(i);
        }
        for(int i=0;i<nums.length;i++){
            if(l.contains(target-nums[i]) && l.indexOf(target-nums[i])!=i){
                ans[0]=i;
                ans[1]=l.indexOf(target-nums[i]);
                break;
            }
        }
        Arrays.sort(ans);
        return ans;
    }
}
