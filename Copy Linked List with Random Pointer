/* time complexity - O(n) 
   space complexity - O(n)
INTUITION
1. Create a map to link each original node to its copy

Walk through the original list once and create a new node for each old node.
Store:
oldNode → newNode
This ensures we can find the clone of any node instantly.

2. Reconnect next and random pointers using the map

Walk the list again:

Set copy.next to the copy of cur.next

Set copy.random to the copy of cur.random

Since the map holds all copies, this becomes simple lookups.

3. Return the copy of the original head

Because all pointers are now properly rebuilt.
*/


/*
// Definition for a Node.
class Node {
    int val;
    Node next;
    Node random;

    public Node(int val) {
        this.val = val;
        this.next = null;
        this.random = null;
    }
}
*/

class Solution {
    public Node copyRandomList(Node head) {
        Map<Node,Node> m = new HashMap<>();
        m.put(null,null);
        Node cur = head;
        while(cur!=null){
            Node copy = new Node(cur.val);
            m.put(cur,copy);
            cur = cur.next;
        }
        cur = head;
        while(cur!=null){
            Node copy = m.get(cur);
            copy.next = m.get(cur.next);
            copy.random = m.get(cur.random);
            cur = cur.next;
        }
        return m.get(head);
        
    }
}
