/*
Let:

n = length of s

m = number of words

k = average word length
n DP states

For each state, we try m words

Each substring comparison costs O(k)
time - O(n * m * k)
space - O(n)


Simple Intuition Steps

Think from the end of the string backward.

At index i, try placing each word from the dictionary.

If a word matches at i:

Check if the remaining suffix can be broken.

If any choice works → dp[i] = true.

Final answer is whether dp[0] is true.
*/
class Solution {
    public boolean wordBreak(String s, List<String> wordDict) {
        //dp[i] - can substring(i,end) be broken into list
        boolean dp[] = new boolean[s.length()+1];
        //empty string
        dp[s.length()]=true;
        for(int i=s.length()-1;i>=0;i--){
            for(String w:wordDict){
                if(i+w.length()<=s.length() && 
                s.substring(i,i+w.length()).equals(w)){
                    dp[i] = dp[i+w.length()];
                }
                if(dp[i])break;
            }
        }
        return dp[0];
    }
}
