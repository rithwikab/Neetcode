/*
⏱️ Time Complexity

O(rows × cols)
Each cell is enqueued and processed at most once.

💾 Space Complexity

O(rows × cols)
Queue can hold all cells in the worst case.

🧠 Simple intuition

Start BFS from all gates at once (multi-source BFS).

Expand level by level.

First time you reach a room is the shortest distance to a gate.

Walls and already-filled cells are skipped.
*/
class Solution {
    public void islandsAndTreasure(int[][] grid) {
        Queue<int[]>q = new LinkedList<>();
        int rows = grid.length;
        int cols = grid[0].length;
        for(int i=0;i<rows;i++){
            for(int j=0;j<cols;j++){
                if(grid[i][j]==0){
                    q.offer(new int[]{i,j});
                }
            }
        }
        if(q.size()==0)return;
        int[][] dirs = {{-1,0},{0,-1},{1,0},{0,1}};
        while(!q.isEmpty()){
            int[] curNode = q.poll();
            int curRow = curNode[0];
            int curCol = curNode[1];
            for(int[] dir:dirs){
                int r = curRow+dir[0];
                int c = curCol + dir[1];
                if(r>=rows || c>=cols || r<0 || c<0 ||
                grid[r][c]!=Integer.MAX_VALUE){
                    continue;
                }
                q.add(new int[]{r,c});
                grid[r][c] = grid[curRow][curCol]+1;
            }
            
        }
    }
}
